# HTCondor submit file for eyedata24_extract_videos_metadata.py
# Submit from this directory:  condor_submit eyedata24_extract_videos_metadata.sub
#
# Streams the eyedata24 webm .tar files from Google Cloud Storage, processes the
# videos in memory, and brings the CSVs back to ./eyedata24_metadata. Existing
# CSVs in ./eyedata24_metadata are sent in with the job, so resubmitting resumes
# where the last run stopped.

container_image = docker://python:3.11-slim

executable = eyedata24_extract_videos_metadata.sh

# Credentials: a service-account key, or the user credentials from
# `gcloud auth application-default login`. Use an absolute path (no ~)
KEY_FILE = /home/cmikulski/.config/gcloud/application_default_credentials.json

# Eye patch cropping comes from eyetracking-utils
ET_UTILS = /home/cmikulski/eyetracking/eyetracking-utils/et_util/process_functions.py

transfer_input_files = eyedata24_extract_videos_metadata.py, blink_utils.py, position_utils.py, $(ET_UTILS), $(KEY_FILE), eyedata24_metadata
transfer_output_files = eyedata24_metadata
should_transfer_files = YES
# If the job is evicted, save the partial CSVs and send them to the restarted job
when_to_transfer_output = ON_EXIT_OR_EVICT

environment = "GOOGLE_APPLICATION_CREDENTIALS=application_default_credentials.json N_WORKERS=$(request_cpus)"

log = logs/eyedata24_extract_videos_metadata_$(Cluster).log
output = logs/eyedata24_extract_videos_metadata_$(Cluster).out
error = logs/eyedata24_extract_videos_metadata_$(Cluster).err

request_cpus = 8
request_memory = 16GB
request_disk = 100GB

queue 1
